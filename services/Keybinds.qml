pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import qs.config

// Hyprland keybinds for luxshell's actions (Settings > Keybinds). Opt-in: nothing is
// written or bound while Settings.keysEnabled is false (the default).
//
//   file      LUXSHELL_KEYS_FILE, else $XDG_CONFIG_HOME/hypr/luxos/luxshell-keys.lua. Generated
//             (head comment "generated by luxshell"), rewritten on every change: per bind
//             `pcall(hl.unbind, keys)` then `hl.bind(keys, hl.dsp.exec_cmd(...), { description =
//             "luxshell: ..." })`. Hyprland's keybinds.lua loads it with dofile(); luxshell loads it
//             live with `hyprctl eval 'dofile(...)'` (the compositor qs runs in: nested in the
//             sandbox). Turning the integration off rewrites it without binds and unbinds the
//             keys live; a key's previous Hyprland bind comes back with the next config reload.
//             Dry run (LUXSHELL_DRYRUN=1) without LUXSHELL_KEYS_FILE writes nothing (log only).
//   binds     Settings.keysBinds { action: "SUPER + SHIFT + D" }; a lone modifier key
//             ("SUPER + Super_L") is a tap, bound on release
//   conflicts hyprctl binds -j (default submap, not ours) and duplicates between actions
//   record    while the settings app records a combo, Hyprland is put into an empty submap
//             ("luxshell-record") so already bound keys reach the window; back to the default
//             submap when done, at the latest after 15 s
//
// IPC (bind targets): qs -c luxshell ipc call media playPause | next | previous
Singleton {
    id: root

    readonly property bool enabled: Settings.keysEnabled
    readonly property string home: Env.get("HOME")
    readonly property string ownFile: Env.get("LUXSHELL_KEYS_FILE")
    readonly property string file: {
        if (ownFile !== "")
            return ownFile;
        const xdg = Env.get("XDG_CONFIG_HOME");
        return (xdg !== "" ? xdg : home + "/.config") + "/hypr/luxos/luxshell-keys.lua";
    }
    readonly property bool canWrite: !Exec.dry || ownFile !== ""

    // the qs command that reaches THIS instance: -c <name> for ~/.config/quickshell/<name>,
    // else -p <shell.qml> (sandbox, candidates)
    readonly property string qs: {
        const dir = String(Quickshell.shellDir).replace(/\/+$/, "");
        const xdg = Env.get("XDG_CONFIG_HOME");
        const base = (xdg !== "" ? xdg : home + "/.config") + "/quickshell/";
        if (dir.startsWith(base) && !dir.slice(base.length).includes("/"))
            return "qs -c " + dir.slice(base.length);
        return "qs -p " + shq(dir + "/shell.qml");
    }

    readonly property var actions: [
        {
            "id": "launcher",
            "label": "Launcher",
            "ipc": "luxshell toggle launcher"
        },
        {
            "id": "controlcenter",
            "label": "Control center",
            "ipc": "luxshell toggle controlcenter"
        },
        {
            "id": "notifications",
            "label": "Notifications",
            "ipc": "luxshell toggle notifications"
        },
        {
            "id": "overview",
            "label": "Window overview",
            "ipc": "luxshell toggle overview"
        },
        {
            "id": "wallpaper",
            "label": "Wallpaper picker",
            "ipc": "luxshell toggle wallpaper"
        },
        {
            "id": "themes",
            "label": "Theme picker",
            "ipc": "luxshell toggle themes"
        },
        {
            "id": "settings",
            "label": "Settings",
            "ipc": "luxshell toggle settings"
        },
        {
            "id": "media",
            "label": "Now playing",
            "ipc": "luxshell toggle media"
        },
        {
            "id": "lock",
            "label": "Lock screen",
            "ipc": "luxshell lock"
        },
        {
            "id": "power",
            "label": "Power menu",
            "ipc": "luxshell toggle power"
        },
        {
            "id": "focus",
            "label": "Focus on / off",
            "ipc": "focus toggle"
        },
        {
            "id": "playPause",
            "label": "Play / pause",
            "ipc": "media playPause",
            "locked": true
        },
        {
            "id": "next",
            "label": "Next track",
            "ipc": "media next",
            "locked": true
        },
        {
            "id": "previous",
            "label": "Previous track",
            "ipc": "media previous",
            "locked": true
        }
    ]
    function action(id: string): var {
        return actions.find(a => a.id === id) ?? null;
    }
    function keysOf(id: string): string {
        const b = Settings.keysBinds ?? {};
        return String(b[id] ?? "");
    }

    // ---- combos ---------------------------------------------------------------------------
    readonly property var modBits: ({
            "SHIFT": 1,
            "CAPS": 2,
            "CTRL": 4,
            "CONTROL": 4,
            "ALT": 8,
            "MOD2": 16,
            "MOD3": 32,
            "SUPER": 64,
            "WIN": 64,
            "LOGO": 64,
            "MOD4": 64,
            "META": 64,
            "MOD5": 128
        })
    readonly property var modKeys: ["super_l", "super_r", "alt_l", "alt_r", "control_l", "control_r", "shift_l", "shift_r", "meta_l", "meta_r"]

    // "SUPER + SHIFT + D" -> { mask: 65, key: "D", tap: false }, null for ""
    function parse(keys: string): var {
        const parts = String(keys).split("+").map(p => p.trim()).filter(p => p !== "");
        if (parts.length === 0)
            return null;
        const key = parts[parts.length - 1];
        let mask = 0;
        for (const m of parts.slice(0, -1))
            mask |= modBits[m.toUpperCase()] ?? 0;
        return {
            "mask": mask,
            "key": key,
            "tap": modKeys.includes(key.toLowerCase())
        };
    }
    function same(a: var, b: var): bool {
        return !!a && !!b && a.mask === b.mask && a.key.toLowerCase() === b.key.toLowerCase();
    }

    // words for the keycaps: "SUPER + SHIFT + D" -> ["Super", "Shift", "D"]; tap -> ["Super"]
    readonly property var keyWords: ({
            "super": "Super",
            "shift": "Shift",
            "ctrl": "Ctrl",
            "control": "Ctrl",
            "alt": "Alt",
            "tab": "Tab",
            "comma": ",",
            "period": ".",
            "slash": "/",
            "backslash": "\\",
            "semicolon": ";",
            "apostrophe": "'",
            "minus": "-",
            "equal": "=",
            "bracketleft": "[",
            "bracketright": "]",
            "grave": "`",
            "space": "Space",
            "return": "Enter",
            "escape": "Esc",
            "backspace": "Backspace",
            "delete": "Del",
            "insert": "Ins",
            "home": "Home",
            "end": "End",
            "page_up": "PgUp",
            "page_down": "PgDn",
            "print": "Print",
            "left": "←",
            "right": "→",
            "up": "↑",
            "down": "↓",
            "xf86audioplay": "Play",
            "xf86audiopause": "Pause",
            "xf86audionext": "Next",
            "xf86audioprev": "Prev",
            "xf86audiostop": "Stop",
            "xf86audiomute": "Mute",
            "xf86audioraisevolume": "Vol+",
            "xf86audiolowervolume": "Vol-",
            "super_l": "Super",
            "super_r": "Super",
            "alt_l": "Alt",
            "alt_r": "Alt"
        })
    function caps(keys: string): var {
        const parts = String(keys).split("+").map(p => p.trim()).filter(p => p !== "");
        const c = parse(keys);
        if (c && c.tap)
            return [keyWords[c.key.toLowerCase()] ?? c.key];
        return parts.map(p => keyWords[p.toLowerCase()] ?? (p.length > 1 && p === p.toUpperCase() ? p[0] + p.slice(1).toLowerCase() : p));
    }
    function pretty(keys: string): string {
        const c = parse(keys);
        if (!c)
            return "Not set";
        return caps(keys).join(" + ") + (c.tap ? " (tap)" : "");
    }

    // ---- Hyprland binds (conflicts) -------------------------------------------------------
    property var hyprBinds: []
    property var replaced: ({}) // "mask|key" -> what our bind replaced (seen before we bound it)
    property bool recordSubmap: false // "luxshell-record" is registered in Hyprland

    function refresh(): void {
        if (!bindsProc.running)
            bindsProc.running = true;
    }
    Process {
        id: bindsProc
        command: ["hyprctl", "binds", "-j"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const all = JSON.parse(text);
                    root.recordSubmap = all.some(b => b.submap === "luxshell-record");
                    root.hyprBinds = all.filter(b => (b.submap ?? "") === "" && (b.key ?? "") !== "");
                } catch (e) {}
            }
        }
    }
    function describeBind(b: var): string {
        if (b.description)
            return b.description;
        if (b.dispatcher && b.dispatcher !== "__lua")
            return `${b.dispatcher} ${b.arg ?? ""}`.trim();
        return "a bind from the Hyprland config";
    }
    function ours(b: var): bool {
        return String(b.description ?? "").startsWith("luxshell:");
    }

    // { kind: "dup" | "hypr" | "replaced" | "", text } for one action's combo (or `keys`)
    function conflict(id: string, keys: var): var {
        const k = keys === undefined ? keysOf(id) : keys;
        const c = parse(k);
        if (!c)
            return {
                "kind": "",
                "text": ""
            };
        for (const a of actions)
            if (a.id !== id && same(c, parse(keysOf(a.id))))
                return {
                    "kind": "dup",
                    "text": `Same keys as ${a.label}`
                };
        const hit = hyprBinds.find(b => !ours(b) && b.modmask === c.mask && String(b.key).toLowerCase() === c.key.toLowerCase());
        if (hit)
            return {
                "kind": "hypr",
                "text": `Taken in Hyprland: ${describeBind(hit)}`
            };
        const rep = replaced[c.mask + "|" + c.key.toLowerCase()];
        if (rep && enabled)
            return {
                "kind": "replaced",
                "text": `Replaces Hyprland: ${rep}`
            };
        return {
            "kind": "",
            "text": ""
        };
    }

    // ---- file + live load -----------------------------------------------------------------
    property var applied: [] // keys our last load bound (from the file at start)
    property string status: enabled ? "" : "Off"
    property string lastText: ""

    function luaStr(s: string): string {
        return '"' + String(s).replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/[\x00-\x1f]/g, "") + '"';
    }
    function shq(s: string): string {
        return /^[A-Za-z0-9_\/.,:=+-]+$/.test(s) ? s : "'" + String(s).replace(/'/g, "'\\''") + "'";
    }
    function command(a: var): string {
        return `${qs} ipc call ${a.ipc}`;
    }

    // the binds that would be written now: [{ keys, cmd, opts, label }]
    function plan(): var {
        if (!enabled)
            return [];
        const out = [];
        const taken = [];
        for (const a of actions) {
            const keys = keysOf(a.id);
            const c = parse(keys);
            if (!c || taken.some(t => same(t, c)))
                continue; // unset, or a duplicate (the first action keeps the keys)
            taken.push(c);
            const opts = [];
            if (c.tap)
                opts.push("release = true");
            if (a.locked)
                opts.push("locked = true");
            opts.push("description = " + luaStr("luxshell: " + a.label));
            out.push({
                "keys": keys,
                "cmd": command(a),
                "opts": opts,
                "label": a.label
            });
        }
        return out;
    }

    function generate(binds: var): string {
        const lines = ["-- generated by luxshell (Settings > Keybinds): rewritten on every change, do not edit.", "-- Hyprland loads it from keybinds.lua: dofile(" + luaStr(file) + ")", "-- luxshell loads changes live: hyprctl eval 'dofile(...)'. Every bind first removes", "-- whatever held its keys (pcall(hl.unbind, keys))."];
        if (binds.length === 0) {
            lines.push("", "-- keybind integration is off (Settings > Keybinds)");
        } else {
            lines.push("");
            for (const b of binds) {
                lines.push(`pcall(hl.unbind, ${luaStr(b.keys)})`);
                lines.push(`hl.bind(${luaStr(b.keys)}, hl.dsp.exec_cmd(${luaStr(b.cmd)}), { ${b.opts.join(", ")} })`);
            }
        }
        return lines.join("\n") + "\n";
    }

    function apply(): void {
        if (!started)
            return;
        const binds = plan();
        const text = generate(binds);
        const keys = binds.map(b => b.keys);
        const gone = applied.filter(k => !keys.some(n => same(parse(n), parse(k))));
        if (!enabled && applied.length === 0 && (!fileExists || text === lastText)) {
            status = "Off";
            return; // opt-in: never create the file before the integration was used; already empty
        }
        // remember what Hyprland had on keys we are about to take
        const rep = Object.assign({}, replaced);
        for (const k of keys) {
            const c = parse(k);
            const id = c.mask + "|" + c.key.toLowerCase();
            const hit = hyprBinds.find(b => !ours(b) && b.modmask === c.mask && String(b.key).toLowerCase() === c.key.toLowerCase());
            if (hit && !rep[id])
                rep[id] = describeBind(hit);
        }
        replaced = rep;
        if (!canWrite) {
            console.info(`luxshell[dry]: keybinds: would write ${file} (${binds.length} binds) and load it`);
            status = `Dry run: ${binds.length} binds not written`;
            return;
        }
        pending = {
            "text": text,
            "unbind": gone,
            "keys": keys
        };
        if (!writer.running)
            flush();
    }
    property var pending: null
    property bool fileExists: false

    function flush(): void {
        if (!pending)
            return;
        const p = pending;
        pending = null;
        writing = p;
        writer.command = ["sh", "-c", 'mkdir -p "$(dirname "$1")" && printf "%s" "$2" > "$1.tmp" && mv -f "$1.tmp" "$1"', "luxshell-keys", file, p.text];
        writer.running = true;
    }
    property var writing: null

    Process {
        id: writer
        stderr: StdioCollector {
            id: writeErr
        }
        onExited: code => {
            const p = root.writing;
            if (code !== 0) {
                root.status = `Could not write the file: ${writeErr.text.trim()}`;
                console.warn(`luxshell: keybinds: ${root.status}`);
            } else {
                root.fileExists = true;
                root.lastText = p.text;
                const lua = p.unbind.map(k => `pcall(hl.unbind, ${root.luaStr(k)})`).concat([`dofile(${root.luaStr(root.file)})`]).join("; ");
                loader.keys = p.keys;
                loader.command = ["hyprctl", "eval", lua];
                loader.running = true;
            }
            root.flush();
        }
    }
    Process {
        id: loader
        property var keys: []
        stdout: StdioCollector {
            onStreamFinished: {
                const out = text.trim();
                if (out === "ok" || out === "") {
                    root.applied = loader.keys;
                    root.status = loader.keys.length === 0 ? "Off: file emptied, binds removed" : loader.keys.length === 1 ? "1 bind loaded" : `${loader.keys.length} binds loaded`;
                } else {
                    root.status = `Hyprland: ${out}`;
                    console.warn(`luxshell: keybinds: hyprctl eval: ${out}`);
                }
                root.refresh();
            }
        }
    }

    // reload Hyprland's whole config (brings back binds luxshell had replaced)
    function reloadHyprland(): void {
        Quickshell.execDetached(["hyprctl", "reload"]);
        refreshLater.restart();
    }
    Timer {
        id: refreshLater
        interval: 800
        onTriggered: root.refresh()
    }

    // debounce: a recorded combo, a reset, an import become one write
    Timer {
        id: applyTimer
        interval: 250
        onTriggered: root.apply()
    }
    readonly property string signature: JSON.stringify([enabled, Settings.keysBinds, qs])
    onSignatureChanged: if (started)
        applyTimer.restart()

    // keys the file bound when Hyprland (or an earlier luxshell) loaded it
    property bool started: false
    FileView {
        id: existing
        path: root.file
        printErrors: false
        onLoaded: {
            root.fileExists = true;
            const keys = [];
            const re = /^hl\.bind\("((?:[^"\\]|\\.)*)"/gm;
            let m;
            const t = text();
            while ((m = re.exec(t)) !== null)
                keys.push(m[1]);
            root.applied = keys;
            root.lastText = t;
            root.begin();
        }
        onLoadFailed: root.begin()
    }
    function begin(): void {
        if (started)
            return;
        started = true;
        refresh();
        if (Settings.ready)
            applyTimer.restart();
    }
    Connections {
        target: Settings
        function onReadyChanged(): void {
            if (root.started)
                applyTimer.restart();
        }
    }
    Connections {
        target: Hyprland
        function onRawEvent(event): void {
            if (event.name === "configreloaded")
                root.refresh();
        }
    }

    // ---- recording (settings app) -------------------------------------------------------
    property bool recording: false
    function recordStart(): void {
        if (recording)
            return;
        recording = true;
        recordGuard.restart();
        const enter = 'hl.dispatch(hl.dsp.submap("luxshell-record"))';
        // an empty submap is not registered: it holds one bind nobody presses (Hyper+F24)
        const define = 'hl.define_submap("luxshell-record", function() hl.bind("CTRL + ALT + SHIFT + SUPER + F24", hl.dsp.submap("reset"), { description = "luxshell: leave key recording" }) end)';
        recProc.command = ["hyprctl", "eval", recordSubmap ? enter : define + "; " + enter];
        recProc.running = true;
        recordSubmap = true;
    }
    function recordStop(): void {
        if (!recording)
            return;
        recording = false;
        recordGuard.stop();
        Quickshell.execDetached(["hyprctl", "dispatch", 'hl.dsp.submap("reset")']);
    }
    Process {
        id: recProc
        stdout: StdioCollector {
            onStreamFinished: if (text.trim() !== "ok" && text.trim() !== "")
                console.warn(`luxshell: keybinds: record submap: ${text.trim()}`)
        }
    }
    Timer {
        id: recordGuard
        interval: 15000
        onTriggered: root.recordStop()
    }

    // ---- media IPC (bind targets; every control goes through services/Media + Exec) ---------
    IpcHandler {
        target: "media"

        function playPause(): void {
            Media.toggle(null);
        }
        function next(): void {
            Media.next(null);
        }
        function previous(): void {
            Media.previous(null);
        }
    }

    IpcHandler {
        target: "keybinds"

        function state(): string {
            return JSON.stringify({
                "enabled": root.enabled,
                "file": root.file,
                "qs": root.qs,
                "status": root.status,
                "applied": root.applied,
                "recording": root.recording,
                "conflicts": root.actions.map(a => [a.id, root.conflict(a.id).text]).filter(x => x[1] !== "")
            });
        }
        function refresh(): void {
            root.refresh();
        }
    }
}

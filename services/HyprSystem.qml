pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import qs.config

// Hyprland settings made in luxshell's "System" pages (Input; later Displays, Autostart):
// the one place that knows what the user changed there, applies it live and writes it as
// a Lua file Hyprland loads at start. (Name: the system side of Hyprland, next to
// services/Hypr (workspaces, windows) and services/HyprLook (luxshell's look in Hyprland).)
//
//   data     sparse, only what was set in luxshell; <Env.configDir>/system.json:
//              config     { "input.sensitivity": 0.3, "input.touchpad.natural_scroll": true }   hl.config paths
//              device     { "logitech-g305-1": { "sensitivity": -0.2 } }                         hl.device
//              monitor    { "DP-3": { "scale": 1.25 } }                                          hl.monitor
//              autostart  [{ "cmd": "nm-applet", "enabled": true }]                             hl.on("hyprland.start")
//            plus `base`: what Hyprland had before luxshell first overrode a path / monitor,
//            i.e. what a reset puts back live (the user's own config or Hyprland's default).
//   file     LUXSHELL_SYSTEM_FILE, else $XDG_CONFIG_HOME/hypr/luxos/luxshell-system.lua. Generated
//            from the data (head comment "generated by luxshell"), one block per section, written
//            only when its text changes, atomically (tmp + mv). Dry run without LUXSHELL_SYSTEM_FILE:
//            log only. hyprland.lua runs it at its very end (guarded loadfile, set by hand).
//   live     every change goes to Hyprland at once through Exec.hyprEval (`hyprctl eval`, Lua:
//            hl.config / hl.device / hl.monitor; `hyprctl keyword` is refused by the Lua config).
//            At start and after a config reload, values Hyprland does not have (file not loaded)
//            are put back.
//   read     `hyprctl -j getoption` for every tracked path, `hyprctl devices -j`,
//            `hyprctl monitors all -j`.
//
// Store API (a settings row's `store`, apps/settings/README.md): get / set / isDefault / reset /
// defaultOf, keys "input.sensitivity" (hl.config path, must be in `tracked`) or
// "device:<name>:<field>" (own value of one device; reset = follow the global value again).
// Config: setMany({ path: value }), resetMany([paths]), current(path), isSet(path).
// Monitors: setMonitor(output, { mode, position, scale, transform, vrr, bitdepth, disabled, ... }),
//           resetMonitor(output), monitorSpec(output) (base + override), monitors (hyprctl).
// Try, then keep (monitor changes): begin(); setMonitor(...); SettingsApp.askKeep({ keep: () =>
//           HyprSystem.commit(), revert: () => HyprSystem.rollback() }) - nothing is written before commit().
// Autostart: autostart (list), setAutostart(list).
// Key repeat stays off on purpose (repeat_rate 0 + xset r off): repeat_* paths are refused.
Singleton {
    id: root

    // ---- files ---------------------------------------------------------------------------
    readonly property string home: Env.get("HOME")
    readonly property string ownFile: Env.get("LUXSHELL_SYSTEM_FILE")
    readonly property string file: {
        if (ownFile !== "")
            return ownFile;
        const xdg = Env.get("XDG_CONFIG_HOME");
        return (xdg !== "" ? xdg : home + "/.config") + "/hypr/luxos/luxshell-system.lua";
    }
    readonly property string dataFile: Env.configDir + "/system.json"
    readonly property bool canWrite: !Exec.dry || ownFile !== ""
    readonly property bool fakeDevices: Env.get("LUXSHELL_FAKE_DEVICES") === "1"

    // ---- what can be set ---------------------------------------------------------------------
    // hl.config paths luxshell may override, with Hyprland's default (the fallback when the
    // value before the first override is unknown). Pages of other areas add theirs here.
    readonly property var tracked: ({
            "input.sensitivity": 0,
            "input.accel_profile": "",
            "input.natural_scroll": false,
            "input.scroll_factor": 1,
            "input.left_handed": false,
            "input.kb_layout": "us",
            "input.kb_variant": "",
            "input.kb_options": "",
            "input.numlock_by_default": false,
            "input.touchpad.natural_scroll": false,
            "input.touchpad.scroll_factor": 1,
            // Settings > Displays: main display (the cursor starts there), global VRR (read only:
            // what a monitor without its own vrr follows)
            "cursor.default_monitor": "",
            "misc.vrr": 0
        })
    readonly property var blocked: ["input.repeat_rate", "input.repeat_delay"]
    // per-device fields and the global path a device follows while it has no own value
    readonly property var deviceFields: ({
            "sensitivity": {
                "global": "input.sensitivity"
            },
            "accel_profile": {
                "global": "input.accel_profile"
            },
            "natural_scroll": {
                "global": "input.natural_scroll",
                "touchpad": "input.touchpad.natural_scroll"
            },
            "scroll_factor": {
                "global": "input.scroll_factor",
                "touchpad": "input.touchpad.scroll_factor"
            },
            "left_handed": {
                "global": "input.left_handed"
            }
        })

    // ---- state ---------------------------------------------------------------------------------
    property var data: ({
            "config": {},
            "device": {},
            "monitor": {},
            "autostart": []
        })
    property var base: ({
            "config": {},
            "monitor": {}
        })
    property var live: ({})       // tracked path -> value Hyprland has now (read, then kept in step)
    property var follow: ({})     // this session: device -> { field: true } reset to follow the global
    property var pending: null    // begin() .. commit() / rollback()
    property var mice: []         // [{ name, label, touchpad }]
    property var keyboards: []    // [{ name, label, layout, variant, options, main }]
    property var monitors: []     // hyprctl monitors all -j
    property bool ready: false    // data, file and live values read
    property string lastError: ""

    readonly property var autostart: data.autostart ?? []

    // ---- helpers -------------------------------------------------------------------------------
    function clone(v: var): var {
        return v === undefined ? undefined : JSON.parse(JSON.stringify(v));
    }
    function same(a: var, b: var): bool {
        return JSON.stringify(a) === JSON.stringify(b);
    }
    function has(o: var, k: string): bool {
        return o !== null && o !== undefined && Object.prototype.hasOwnProperty.call(o, k);
    }
    function tilde(p: string): string {
        return home !== "" && p.startsWith(home + "/") ? "~" + p.slice(home.length) : p;
    }
    // a value in the type of the path's default
    function coerce(path: string, v: var): var {
        const d = tracked[path];
        if (typeof d === "number")
            return Number(v) || 0;
        if (typeof d === "boolean")
            return v === true || v === 1 || v === "true" || v === "1";
        return v === null || v === undefined ? "" : String(v);
    }
    function round(n: real): real {
        return Math.round(n * 10000) / 10000;
    }

    // ---- reading values (bindings: every function reads reactive properties) --------------------
    function isSet(path: string): bool {
        return has(data.config, path);
    }
    // what Hyprland has now: luxshell's value, else the one read from Hyprland, else its default
    function current(path: string): var {
        if (has(data.config, path))
            return data.config[path];
        if (has(live, path))
            return live[path];
        return tracked[path];
    }
    // what a reset of the path gives back
    function baseOf(path: string): var {
        if (has(base.config, path))
            return base.config[path];
        if (!has(data.config, path) && has(live, path))
            return live[path];
        return tracked[path];
    }

    function isTouchpad(name: string): bool {
        const m = mice.find(x => x.name === name);
        return m ? m.touchpad : /touchpad|trackpad|glidepoint|synaptics/i.test(name);
    }
    function globalOf(name: string, field: string): string {
        const f = deviceFields[field];
        if (!f)
            return "";
        return isTouchpad(name) && f.touchpad ? f.touchpad : f.global;
    }
    function deviceIsSet(name: string, field: string): bool {
        return has(data.device[name], field);
    }
    function deviceValue(name: string, field: string): var {
        if (deviceIsSet(name, field))
            return data.device[name][field];
        return current(globalOf(name, field));
    }
    // fields of one device with an own value
    function deviceOwn(name: string): var {
        return Object.keys(data.device[name] ?? {});
    }

    // ---- store API (settings rows) ---------------------------------------------------------------
    function parseKey(key: string): var {
        if (key.startsWith("device:")) {
            const i = key.lastIndexOf(":");
            return {
                "device": key.slice(7, i),
                "field": key.slice(i + 1)
            };
        }
        return {
            "path": key
        };
    }
    function get(key: string): var {
        const k = parseKey(key);
        return k.device !== undefined ? deviceValue(k.device, k.field) : current(k.path);
    }
    function set(key: string, value: var): bool {
        const k = parseKey(key);
        if (k.device !== undefined)
            return setDevice(k.device, k.field, value);
        const o = {};
        o[k.path] = value;
        return setMany(o);
    }
    function isDefault(key: string): bool {
        const k = parseKey(key);
        return k.device !== undefined ? !deviceIsSet(k.device, k.field) : !isSet(k.path);
    }
    function reset(key: string): void {
        const k = parseKey(key);
        if (k.device !== undefined)
            resetDevice(k.device, k.field);
        else
            resetMany([k.path]);
    }
    function defaultOf(key: string): var {
        const k = parseKey(key);
        return k.device !== undefined ? current(globalOf(k.device, k.field)) : baseOf(k.path);
    }

    // ---- config paths --------------------------------------------------------------------------
    function allowed(path: string): bool {
        if (blocked.includes(path)) {
            console.warn(`luxshell: system settings: ${path} is not set by luxshell (key repeat stays off)`);
            return false;
        }
        if (!has(tracked, path)) {
            console.warn(`luxshell: system settings: ${path} is not tracked (add it to HyprSystem.tracked)`);
            return false;
        }
        return true;
    }

    // { "input.kb_layout": "de,us", "input.kb_variant": "," }: one hl.config, one write
    // A value equal to what a reset gives back is a reset (sparse, like config/Settings).
    function setMany(values: var): bool {
        const d = clone(data), b = clone(base), l = Object.assign({}, live);
        const out = {}, back = [];
        for (const path in values) {
            if (!allowed(path))
                return false;
            const v = coerce(path, values[path]);
            if (has(d.config, path) && same(d.config[path], v))
                continue;
            if (same(v, baseOf(path))) {
                if (has(d.config, path))
                    back.push(path);
                continue;
            }
            noteUndo("config:" + path, configLua(pathValue(path, current(path))));
            if (!has(d.config, path) && !has(b.config, path))
                b.config[path] = has(live, path) ? live[path] : tracked[path];
            d.config[path] = v;
            l[path] = v;
            out[path] = v;
        }
        if (Object.keys(out).length > 0) {
            base = b;
            data = d;
            live = l;
            push(configLua(out), "set " + Object.keys(out).join(", "));
            followGlobals(out);
            changed();
        }
        if (back.length > 0)
            resetMany(back);
        return true;
    }

    function resetMany(paths: var): void {
        const d = clone(data), b = clone(base), l = Object.assign({}, live);
        const out = {};
        for (const path of paths) {
            if (!has(d.config, path))
                continue;
            noteUndo("config:" + path, configLua(pathValue(path, current(path))));
            const v = has(b.config, path) ? b.config[path] : tracked[path];
            delete d.config[path];
            delete b.config[path];
            l[path] = v;
            out[path] = v;
        }
        if (Object.keys(out).length === 0)
            return;
        base = b;
        data = d;
        live = l;
        push(configLua(out), "reset " + Object.keys(out).join(", "));
        followGlobals(out);
        changed();
    }

    function pathValue(path: string, v: var): var {
        const o = {};
        o[path] = v;
        return o;
    }

    // ---- devices ---------------------------------------------------------------------------------
    function setDevice(name: string, field: string, value: var): bool {
        const g = globalOf(name, field);
        if (g === "") {
            console.warn(`luxshell: system settings: no device field "${field}"`);
            return false;
        }
        const v = coerce(g, value);
        if (deviceIsSet(name, field) && same(data.device[name][field], v))
            return true;
        if (same(v, current(g))) { // the global value: follow it again
            resetDevice(name, field);
            return true;
        }
        noteUndo(`device:${name}:${field}`, deviceLua(name, field, deviceValue(name, field)));
        const d = clone(data);
        d.device[name] = Object.assign({}, d.device[name] ?? {});
        d.device[name][field] = v;
        data = d;
        unfollow(name, field);
        push(deviceLua(name, field, v), `device ${name} ${field}`);
        changed();
        return true;
    }

    // Hyprland keeps a device value until the next config reload (hl.device merges, it cannot
    // unset): set it to the global value and keep it in step with the global this session
    function resetDevice(name: string, field: string): void {
        if (!deviceIsSet(name, field))
            return;
        noteUndo(`device:${name}:${field}`, deviceLua(name, field, deviceValue(name, field)));
        const d = clone(data);
        delete d.device[name][field];
        if (Object.keys(d.device[name]).length === 0)
            delete d.device[name];
        data = d;
        const f = clone(follow);
        f[name] = Object.assign({}, f[name] ?? {});
        f[name][field] = true;
        follow = f;
        push(deviceLua(name, field, current(globalOf(name, field))), `device ${name} ${field} follows the global value`);
        changed();
    }
    function resetDeviceAll(name: string): void {
        for (const field of deviceOwn(name))
            resetDevice(name, field);
    }
    function unfollow(name: string, field: string): void {
        if (!has(follow[name], field))
            return;
        const f = clone(follow);
        delete f[name][field];
        follow = f;
    }
    // globals changed: devices that follow them get the new value
    function followGlobals(changedPaths: var): void {
        for (const name in follow)
            for (const field in follow[name]) {
                const g = globalOf(name, field);
                if (has(changedPaths, g))
                    push(deviceLua(name, field, changedPaths[g]), `device ${name} ${field} follows ${g}`);
            }
    }

    // ---- monitors --------------------------------------------------------------------------------
    function liveMonitor(output: string): var {
        return monitors.find(m => m.name === output) ?? null;
    }
    function hz(r: real): string {
        return String(Math.round(r * 100) / 100);
    }
    // hyprctl monitors entry -> hl.monitor fields (what a rule needs to keep it as it is).
    // hl.monitor MERGES with the rule Hyprland has (a field left out keeps its last value), so
    // every field Settings > Displays may set is spelled out here: a reset or a rollback then
    // puts it back too. vrr: the rule's value is not in hyprctl; active while misc.vrr is off
    // means the monitor has its own (1).
    function specOfLive(m: var): var {
        const miscVrr = Number(current("misc.vrr")) || 0;
        const src = String(m.mirrorOf ?? "none") === "none" ? null : monitors.find(x => String(x.id) === String(m.mirrorOf) || x.name === m.mirrorOf);
        return {
            "mode": `${m.width}x${m.height}@${hz(m.refreshRate)}`,
            "position": `${m.x}x${m.y}`,
            "scale": round(m.scale),
            "transform": m.transform,
            "bitdepth": /2101010|161616/i.test(String(m.currentFormat ?? "")) ? 10 : 8,
            "cm": String(m.colorManagementPreset ?? "") !== "" ? String(m.colorManagementPreset) : "srgb",
            "vrr": m.vrr === true && miscVrr === 0 ? 1 : miscVrr,
            "mirror": src ? src.name : "",
            "disabled": m.disabled === true
        };
    }
    // the full rule luxshell gives an output: base (as it was) + what was changed
    function monitorSpec(output: string): var {
        const m = liveMonitor(output);
        const b = base.monitor[output] ?? (m ? specOfLive(m) : {});
        return Object.assign({}, b, data.monitor[output] ?? {});
    }
    function monitorIsSet(output: string): bool {
        return has(data.monitor, output);
    }

    // fields: { mode: "2560x1440@180", position: "0x0", scale: 1.25, transform: 0, vrr: 1,
    // bitdepth: 10, disabled: false, ... } (HL.MonitorSpec); a null value drops the field
    function setMonitor(output: string, fields: var): void {
        noteUndo("monitor:" + output, monitorLua(output, monitorSpec(output)));
        const d = clone(data), b = clone(base);
        if (!has(d.monitor, output) && !has(b.monitor, output)) {
            const m = liveMonitor(output);
            if (m)
                b.monitor[output] = specOfLive(m);
        }
        const spec = Object.assign({}, d.monitor[output] ?? {});
        for (const k in fields) {
            if (fields[k] === null || fields[k] === undefined)
                delete spec[k];
            else
                spec[k] = fields[k];
        }
        d.monitor[output] = spec;
        base = b;
        data = d;
        push(monitorLua(output, Object.assign({}, b.monitor[output] ?? {}, spec)), "monitor " + output);
        changed();
    }
    function resetMonitor(output: string): void {
        if (!has(data.monitor, output))
            return;
        noteUndo("monitor:" + output, monitorLua(output, monitorSpec(output)));
        const d = clone(data), b = clone(base);
        const back = b.monitor[output];
        delete d.monitor[output];
        delete b.monitor[output];
        base = b;
        data = d;
        if (back)
            push(monitorLua(output, back), "monitor " + output + " back to its rule");
        changed();
    }

    // ---- autostart (file only, nothing live) -------------------------------------------------------
    function setAutostart(list: var): void {
        const clean = Array.from(list ?? []).filter(e => e && String(e.cmd ?? "").trim() !== "").map(e => ({
                    "cmd": String(e.cmd).trim(),
                    "enabled": e.enabled !== false
                }));
        if (same(clean, autostart))
            return;
        const d = clone(data);
        d.autostart = clean;
        data = d;
        changed();
    }

    // ---- try, then keep ------------------------------------------------------------------------------
    // begin() opens a change that is applied live but not written; commit() writes it,
    // rollback() puts back, live, what Hyprland had at begin() (everything touched meanwhile).
    function begin(): void {
        if (pending)
            return;
        pending = {
            "data": clone(data),
            "base": clone(base),
            "live": clone(live),
            "follow": clone(follow),
            "undo": {}
        };
    }
    function noteUndo(key: string, lua: string): void {
        if (!pending || has(pending.undo, key))
            return;
        const p = Object.assign({}, pending);
        p.undo = Object.assign({}, p.undo);
        p.undo[key] = lua;
        pending = p;
    }
    function commit(): void {
        if (!pending)
            return;
        pending = null;
        changed();
    }
    function rollback(): void {
        if (!pending)
            return;
        const p = pending;
        pending = null;
        for (const k in p.undo)
            push(p.undo[k], "rollback " + k);
        data = p.data;
        base = p.base;
        live = p.live;
        follow = p.follow;
    }

    // ---- Lua -------------------------------------------------------------------------------------------
    function luaStr(s: string): string {
        return '"' + String(s).replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\n/g, "\\n").replace(/[\x00-\x1f]/g, "") + '"';
    }
    function luaKey(k: string): string {
        return /^[A-Za-z_][A-Za-z0-9_]*$/.test(k) ? k : `[${luaStr(k)}]`;
    }
    function luaVal(v: var): string {
        if (typeof v === "boolean")
            return v ? "true" : "false";
        if (typeof v === "number")
            return String(round(v));
        if (v !== null && typeof v === "object")
            return luaTable(v, -1);
        return luaStr(v);
    }
    // a table; indent < 0 = one line, else one field per line at that depth
    function luaTable(o, indent, first) {
        const keys = Object.keys(o).sort((a, b) => (a === first ? -1 : b === first ? 1 : a.localeCompare(b)));
        if (indent < 0)
            return "{ " + keys.map(k => `${luaKey(k)} = ${luaVal(o[k])}`).join(", ") + " }";
        const pad = "    ".repeat(indent + 1);
        const lines = keys.map(k => {
            const v = o[k];
            const nested = v !== null && typeof v === "object" && !Array.isArray(v);
            return `${pad}${luaKey(k)} = ${nested ? luaTable(v, indent + 1) : luaVal(v)},`;
        });
        return "{\n" + lines.join("\n") + "\n" + "    ".repeat(indent) + "}";
    }
    // { "input.touchpad.natural_scroll": true } -> { input = { touchpad = { natural_scroll = true } } }
    function tree(values: var): var {
        const t = {};
        for (const path in values) {
            const parts = path.split(".");
            let n = t;
            for (let i = 0; i < parts.length - 1; i++)
                n = n[parts[i]] = n[parts[i]] ?? {};
            n[parts[parts.length - 1]] = values[path];
        }
        return t;
    }
    function configLua(values: var): string {
        return `hl.config(${luaTable(tree(values), -1)})`;
    }
    function deviceLua(name: string, field: string, v: var): string {
        const o = {
            "name": name
        };
        o[field] = v;
        return `hl.device(${luaTable(o, -1, "name")})`;
    }
    function monitorLua(output: string, spec: var): string {
        return `hl.monitor(${luaTable(Object.assign({
            "output": output
        }, spec), -1, "output")})`;
    }

    // the whole file from the data
    function generate(): string {
        const out = ["-- generated by luxshell (Settings > System): rewritten on every change, do not edit.", "-- Runs at the end of hyprland.lua. luxshell keeps these values in " + tilde(dataFile), "-- and applies every change live (hyprctl eval). Reset an option in the settings app to", "-- give it back to the rest of the Hyprland config."];
        let any = false;
        const t = tree(data.config);
        const tops = Object.keys(t).sort((a, b) => (a === "input" ? -1 : b === "input" ? 1 : a.localeCompare(b)));
        for (const top of tops) {
            const o = {};
            o[top] = t[top];
            out.push("", "-- " + top, `hl.config(${luaTable(o, 0)})`);
            any = true;
        }
        const devs = Object.keys(data.device).filter(n => Object.keys(data.device[n]).length > 0).sort();
        if (devs.length > 0) {
            out.push("", "-- device (own values; every other device follows input)");
            for (const n of devs)
                out.push(`hl.device(${luaTable(Object.assign({
                    "name": n
                }, data.device[n]), -1, "name")})`);
            any = true;
        }
        const mons = Object.keys(data.monitor).sort();
        if (mons.length > 0) {
            out.push("", "-- monitor");
            for (const m of mons)
                out.push(monitorLua(m, Object.assign({}, base.monitor[m] ?? {}, data.monitor[m])));
            any = true;
        }
        const starts = autostart.filter(e => e.enabled);
        if (starts.length > 0) {
            out.push("", "-- autostart");
            for (const e of starts)
                out.push(`hl.on("hyprland.start", function() hl.exec_cmd(${luaStr(e.cmd)}) end)`);
            any = true;
        }
        if (!any)
            out.push("", "-- nothing set in luxshell");
        return out.join("\n") + "\n";
    }

    // ---- live --------------------------------------------------------------------------------------------
    property var queue: []
    property bool busy: false

    function push(lua: string, what: string): void {
        queue = [...queue, {
                "lua": lua,
                "what": what
            }];
        flushTimer.restart();
    }
    Timer {
        id: flushTimer
        interval: 60 // a reset page or a layout change become one eval
        onTriggered: root.flush()
    }
    function flush(): void {
        if (queue.length === 0)
            return;
        if (busy) {
            flushTimer.restart();
            return;
        }
        const q = queue;
        queue = [];
        busy = true;
        Exec.hyprEval(q.map(x => x.lua).join("\n"), "system settings: " + q.map(x => x.what).join("; "), (ok, text) => {
            root.busy = false;
            root.lastError = ok ? "" : text;
        });
    }

    // put back what Hyprland lacks (luxshell's file not loaded, or loaded before a change)
    function heal(): void {
        const cfg = {};
        for (const path in data.config)
            if (!has(live, path) || !same(live[path], data.config[path]))
                cfg[path] = data.config[path];
        if (Object.keys(cfg).length > 0)
            push(configLua(cfg), "restore " + Object.keys(cfg).join(", "));
        const l = Object.assign({}, live);
        for (const p in cfg)
            l[p] = cfg[p];
        live = l;
        // device values cannot be read back: set them again (no visible effect when equal)
        for (const n in data.device)
            for (const f in data.device[n])
                push(deviceLua(n, f, data.device[n][f]), `restore device ${n} ${f}`);
        for (const o in data.monitor) {
            const m = liveMonitor(o);
            if (m && !monitorMatches(m, monitorSpec(o)))
                push(monitorLua(o, monitorSpec(o)), "restore monitor " + o);
        }
    }
    // does the live monitor already look like the rule? (unknown fields count as equal)
    function monitorMatches(m: var, spec: var): bool {
        const mode = /^(\d+)x(\d+)(?:@([\d.]+))?/.exec(String(spec.mode ?? ""));
        if (mode && (+mode[1] !== m.width || +mode[2] !== m.height || (mode[3] && Math.abs(+mode[3] - m.refreshRate) > 0.5)))
            return false;
        const pos = /^(-?\d+)x(-?\d+)$/.exec(String(spec.position ?? ""));
        if (pos && (+pos[1] !== m.x || +pos[2] !== m.y))
            return false;
        if (typeof spec.scale === "number" && Math.abs(spec.scale - m.scale) > 0.005)
            return false;
        if (spec.transform !== undefined && +spec.transform !== m.transform)
            return false;
        if (spec.disabled !== undefined && !!spec.disabled !== !!m.disabled)
            return false;
        return true;
    }

    // ---- persist -------------------------------------------------------------------------------------------
    property string lastLua: ""
    property string lastJson: ""
    property bool luaRead: false
    property bool jsonRead: false

    function changed(): void {
        saveTimer.restart();
    }
    Timer {
        id: saveTimer
        interval: 250
        onTriggered: root.persist()
    }
    function persist(): void {
        if (pending || !luaRead || !jsonRead)
            return; // try-then-keep: written by commit(); start: not read yet
        if (writer.running) {
            saveTimer.restart();
            return;
        }
        const json = JSON.stringify({
            "version": 1,
            "config": data.config,
            "device": data.device,
            "monitor": data.monitor,
            "autostart": data.autostart,
            "base": base
        }, null, 2) + "\n";
        const lua = generate();
        const args = [];
        if (json !== lastJson)
            args.push(dataFile, json);
        if (lua !== lastLua) {
            if (canWrite)
                args.push(file, lua);
            else {
                console.info(`luxshell[dry]: system settings: would write ${file}:\n${lua}`);
                lastLua = lua;
            }
        }
        if (args.length === 0)
            return;
        writer.texts = {
            "json": json,
            "lua": lua,
            "files": args.filter((_, i) => i % 2 === 0)
        };
        writer.command = ["sh", "-c", 'while [ $# -gt 1 ]; do mkdir -p "$(dirname "$1")" && printf "%s" "$2" > "$1.tmp" && mv -f "$1.tmp" "$1" || exit 1; shift 2; done', "luxshell-system", ...args];
        writer.running = true;
    }
    Process {
        id: writer
        property var texts: ({})
        stderr: StdioCollector {
            id: writeErr
        }
        onExited: code => {
            if (code !== 0) {
                root.lastError = `could not write: ${writeErr.text.trim()}`;
                console.warn(`luxshell: system settings: ${root.lastError}`);
                return;
            }
            if (texts.files.includes(root.dataFile))
                root.lastJson = texts.json;
            if (texts.files.includes(root.file))
                root.lastLua = texts.lua;
        }
    }

    // ---- start ------------------------------------------------------------------------------------------------
    FileView {
        path: root.dataFile
        printErrors: false
        onLoaded: {
            const t = text();
            try {
                const o = JSON.parse(t);
                root.data = {
                    "config": o.config ?? {},
                    "device": o.device ?? {},
                    "monitor": o.monitor ?? {},
                    "autostart": o.autostart ?? []
                };
                root.base = {
                    "config": o.base?.config ?? {},
                    "monitor": o.base?.monitor ?? {}
                };
                root.lastJson = t;
            } catch (e) {
                console.warn(`luxshell: ${root.dataFile} is no valid JSON (${e}), starting empty; copied to system.json.broken`);
                Quickshell.execDetached(["cp", "-f", root.dataFile, root.dataFile + ".broken"]);
            }
            root.jsonRead = true;
            root.start();
        }
        onLoadFailed: {
            root.jsonRead = true;
            root.start();
        }
    }
    FileView {
        path: root.file
        printErrors: false
        onLoaded: {
            root.lastLua = text();
            root.luaRead = true;
            root.start();
        }
        onLoadFailed: {
            root.luaRead = true;
            root.start();
        }
    }
    function start(): void {
        if (!luaRead || !jsonRead || started)
            return;
        started = true;
        readLive();
        refreshDevices();
        refreshMonitors();
    }
    property bool started: false

    function readLive(): void {
        if (!reader.running)
            reader.running = true;
    }
    Process {
        id: reader
        command: ["sh", "-c", 'for o; do hyprctl -j getoption "$o" | tr -d "\\n"; echo; done', "sh", ...Object.keys(root.tracked).map(p => p.replace(/\./g, ":"))]
        stdout: StdioCollector {
            onStreamFinished: {
                const l = {};
                for (const line of text.split("\n")) {
                    if (line.trim() === "")
                        continue;
                    try {
                        const o = JSON.parse(line);
                        let v = o.float ?? o.int ?? o.bool ?? o.str ?? o.custom;
                        if (v === "[[EMPTY]]")
                            v = "";
                        const path = String(o.option ?? "").replace(/:/g, ".");
                        if (root.has(root.tracked, path) && v !== undefined)
                            l[path] = root.coerce(path, v);
                    } catch (e) {}
                }
                root.live = l;
                if (!root.ready) {
                    root.ready = true;
                    healTimer.restart();
                } else if (root.healAfterRead) {
                    root.healAfterRead = false;
                    healTimer.restart();
                }
            }
        }
    }
    property bool healAfterRead: false
    Timer {
        id: healTimer
        interval: 400 // monitors are read by then
        onTriggered: root.heal()
    }

    function refreshDevices(): void {
        if (fakeDevices) {
            setDevices(fakeDeviceList);
            return;
        }
        if (!devProc.running)
            devProc.running = true;
    }
    Process {
        id: devProc
        command: ["hyprctl", "devices", "-j"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    root.setDevices(JSON.parse(text));
                } catch (e) {}
            }
        }
    }
    // pointers only: the extra event nodes of keyboards (consumer / system control) are no mice
    function setDevices(all: var): void {
        const skip = /consumer-control|system-control|power-button|sleep-button|video-bus|hotkeys|-wmi|lid-switch/i;
        const mice = (all.mice ?? []).filter(m => !skip.test(m.name)).map(m => ({
                    "name": m.name,
                    "label": pretty(m.name),
                    "touchpad": /touchpad|trackpad|glidepoint|synaptics/i.test(m.name)
                }));
        const kbs = (all.keyboards ?? []).filter(k => !skip.test(k.name)).map(k => ({
                    "name": k.name,
                    "label": pretty(k.name),
                    "layout": k.layout ?? "",
                    "variant": k.variant ?? "",
                    "options": k.options ?? "",
                    "main": k.main === true
                }));
        if (!same(mice, root.mice))
            root.mice = mice;
        if (!same(kbs, root.keyboards))
            root.keyboards = kbs;
    }
    // "logitech-g305-1" -> "Logitech G305"
    function pretty(name: string): string {
        const up = ["usb", "rgb", "hid", "ps2", "ii", "iii", "tp", "ms"];
        return name.replace(/-\d+$/, "").split(/[-_\s]/).filter(w => w !== "" && !/^[0-9a-f]{4}:[0-9a-f]{4}$/i.test(w)).map(w => w.replace(/:[0-9a-f]+$/i, "")).map(w => /\d/.test(w) || up.includes(w.toLowerCase()) ? w.toUpperCase() : w[0].toUpperCase() + w.slice(1)).join(" ");
    }
    readonly property var fakeDeviceList: ({
            "mice": [
                {
                    "name": "logitech-g305-1"
                },
                {
                    "name": "elan0712:00-04f3:30fd-touchpad"
                },
                {
                    "name": "semico-usb-keyboard-consumer-control-1"
                }
            ],
            "keyboards": [
                {
                    "name": "semico-usb-keyboard",
                    "layout": "de",
                    "variant": "",
                    "options": "",
                    "main": true
                },
                {
                    "name": "logitech-g305",
                    "layout": "de",
                    "variant": "",
                    "options": "",
                    "main": false
                }
            ]
        })

    function refreshMonitors(): void {
        if (!monProc.running)
            monProc.running = true;
    }
    Process {
        id: monProc
        command: ["hyprctl", "monitors", "all", "-j"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const m = JSON.parse(text);
                    if (!root.same(m, root.monitors))
                        root.monitors = m;
                } catch (e) {}
            }
        }
    }

    Connections {
        target: Hyprland
        function onRawEvent(event: var): void {
            switch (event.name) {
            case "configreloaded":
                // device values were dropped, Hyprland re-read its config (with or without our file)
                root.follow = {};
                root.healAfterRead = true;
                root.readLive();
                root.refreshMonitors();
                root.refreshDevices();
                break;
            case "monitoradded":
            case "monitoraddedv2":
            case "monitorremoved":
            case "monitorremovedv2":
                root.refreshMonitors();
                root.refreshDevices();
                break;
            }
        }
    }

    IpcHandler {
        target: "system"

        // qs ipc call system state | file | get <key> | set <key> <json> | reset <key> | resetMonitor <output> | refresh
        // (try a monitor change with the keep dialog: qs ipc call settings tryMonitor <output> <json>)
        function state(): string {
            return JSON.stringify({
                "ready": root.ready,
                "file": root.file,
                "dataFile": root.dataFile,
                "canWrite": root.canWrite,
                "pending": root.pending !== null,
                "lastError": root.lastError,
                "data": root.data,
                "base": root.base,
                "live": root.live,
                "follow": root.follow,
                "mice": root.mice.map(m => m.name)
            });
        }
        function file(): string {
            return root.generate();
        }
        function get(key: string): string {
            return JSON.stringify(root.get(key)) ?? "undefined";
        }
        function set(key: string, value: string): string {
            let v;
            try {
                v = JSON.parse(value);
            } catch (e) {
                v = value;
            }
            return root.set(key, v) ? "ok" : "refused (see log)";
        }
        function reset(key: string): string {
            root.reset(key);
            return "ok";
        }
        function resetMonitor(output: string): string {
            root.resetMonitor(output);
            return "ok";
        }
        function refresh(): void {
            root.readLive();
            root.refreshDevices();
            root.refreshMonitors();
        }
    }
}

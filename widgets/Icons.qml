    function hex(c: color): string {
        const h = v => Math.round(v * 255).toString(16).padStart(2, "0");
        return "#" + h(c.r) + h(c.g) + h(c.b);
    }

    function url(name: string, c: color, stroke: real, filled: bool): string {
        const body = bodies[name];
        if (body === undefined) {
            console.warn(`luxshell: unknown icon "${name}"`);
            return "";
        }
        const col = hex(c);
        const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="${filled ? col : "none"}" fill-opacity="${c.a}" stroke="${col}" stroke-opacity="${c.a}" stroke-width="${stroke}" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;
        return "data:image/svg+xml;utf8," + encodeURIComponent(svg);
    }
